<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Performance Dashboard" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
<GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="3" android:useDefaultMargins="true">
<TextView android:id="@+id/cardSessions" android:layout_width="0dp" android:layout_columnWeight="1" android:background="@drawable/bg_panel" android:padding="14dp" android:text="Sessions\n0" android:textColor="@color/text"/>
<TextView android:id="@+id/cardReps" android:layout_width="0dp" android:layout_columnWeight="1" android:background="@drawable/bg_panel" android:padding="14dp" android:text="Total Reps\n0" android:textColor="@color/text"/>
<TextView android:id="@+id/cardBestMean" android:layout_width="0dp" android:layout_columnWeight="1" android:background="@drawable/bg_panel" android:padding="14dp" android:text="Best Mean\n0.00" android:textColor="@color/text"/>
<TextView android:id="@+id/cardBestPeak" android:layout_width="0dp" android:layout_columnWeight="1" android:background="@drawable/bg_panel" android:padding="14dp" android:text="Best Peak\n0.00" android:textColor="@color/text"/>
<TextView android:id="@+id/cardVolume" android:layout_width="0dp" android:layout_columnWeight="1" android:background="@drawable/bg_panel" android:padding="14dp" android:text="Volume\n0 kg" android:textColor="@color/text"/>
<TextView android:id="@+id/cardAvgLoss" android:layout_width="0dp" android:layout_columnWeight="1" android:background="@drawable/bg_panel" android:padding="14dp" android:text="Avg Loss\n0%" android:textColor="@color/text"/>
</GridLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mean Velocity Trend" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="14dp"/>
<com.hirocross.vbt.VelocityChartView android:id="@+id/chartMean" android:layout_width="match_parent" android:layout_height="230dp" android:background="@drawable/bg_panel" android:layout_marginTop="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estimated 1RM Trend" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="14dp"/>
<com.hirocross.vbt.VelocityChartView android:id="@+id/chartOneRm" android:layout_width="match_parent" android:layout_height="230dp" android:background="@drawable/bg_panel" android:layout_marginTop="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Velocity Loss Trend" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="14dp"/>
<com.hirocross.vbt.VelocityChartView android:id="@+id/chartLoss" android:layout_width="match_parent" android:layout_height="230dp" android:background="@drawable/bg_panel" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/dashboardSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:background="@drawable/bg_panel" android:padding="14dp" android:layout_marginTop="14dp" android:text="Belum ada data latihan."/>
</LinearLayout></ScrollView>
